programa {
  funcao inicio() {
    cadeia seuNome
    inteiro idade
    real altura 

    escreva ("Insira seu nome: ")
    leia (seuNome)
    escreva ("Insira sua idade: ")
    leia (idade)
    escreva ("Insira sua altura: ")
    leia (altura)

    escreva ("Nome: ", seuNome, "\nIdade: ", idade, " Anos", "\nAltura: ", altura, " metros")
  }
}
